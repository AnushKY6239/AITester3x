    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a Senior QA Test Architect.\n\nAnalyze the following requirement document and create a complete Test Plan.\n\nInclude:\n- Scope\n- Objectives\n- Assumptions\n- Risks\n- Test Strategy\n- Functional Testing\n- Non-Functional Testing\n- Test Environment\n- Entry Criteria\n- Exit Criteria\n- Deliverables\n- Test Schedule\n- Resource Requirements\n\nDocument:\n{{ $json.text }}\n\nOutput structured markdown.",
        "options": {
          "systemMessage": "You are a Senior QA Test Architect specialized in creating comprehensive test plans. Generate detailed, structured markdown documentation.",
          "maxIterations": 10
        }
      },
      "id": "e42cb84a-50ca-4c41-894a-bb819c4093d3",
      "name": "Generate Test Plan",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        688,
        400
      ]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "maxTokensToSample": 8000,
          "temperature": 0.7
        }
      },
      "id": "4d7acbbf-6377-4388-9612-385a4e154d77",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
