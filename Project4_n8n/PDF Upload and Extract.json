    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a Senior Automation Engineer.\n\nConvert the provided test cases into Playwright JAVA test scripts.\n\nRequirements:\n- Use JAVA and Playwright\n- Use best practices\n- Create meaningful test names\n- Add comments\n- Use reusable locators\n- Include assertions\n- Generate executable JAVA code\n\nTest Cases:\n{{ $(\"Generate Test Cases\").item.json.output }}\n\nReturn ONLY the JAVA code without any markdown formatting or code blocks.",
        "options": {
          "systemMessage": "You are a Senior Automation Engineer specialized in creating JAVA Playwright test scripts. Generate clean, executable JAVA code based on test cases. Return ONLY the JAVA code without markdown formatting.",
          "maxIterations": 10
        }
      },
