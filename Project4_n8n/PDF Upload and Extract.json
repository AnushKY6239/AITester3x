    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a Senior QA Test Architect.\n\nAnalyze the following requirement document and create a complete Test Plan.\n\nInclude:\n- Scope\n- Objectives\n- Assumptions\n- Risks\n- Test Strategy\n- Functional Testing\n- Non-Functional Testing\n- Test Environment\n- Entry Criteria\n- Exit Criteria\n- Deliverables\n- Test Schedule\n- Resource Requirements\n\nDocument:\n{{ $json.text }}\n\nOutput structured markdown.",
        "options": {
          "systemMessage": "You are a Senior QA Test Architect specialized in creating comprehensive test plans. Generate detailed, structured markdown documentation.",
          "maxIterations": 10
        }
      },
      "id": "e42cb84a-50ca-4c41-894a-bb819c4093d3",
      "name": "Generate Test Plan",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        688,
        400
      ]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "maxTokensToSample": 8000,
          "temperature": 0.7
        }
      },
      "id": "4d7acbbf-6377-4388-9612-385a4e154d77",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        768,
        624
      ],
      "credentials": {
        "groqApi": {
          "id": "wE5qvOgIYrkwF6rt",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "output",
        "options": {
          "fileName": "=test-plan-{{ $now.toFormat(\"yyyy-MM-dd-HHmmss\") }}.md"
        }
      },
      "id": "0cee24aa-8615-4d22-9683-7ed49ee2eaf2",
      "name": "Convert to Markdown File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        1040,
        304
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=test-plan-{{ $now.toFormat(\"yyyy-MM-dd-HHmmss\") }}.md",
        "options": {}
      },
      "id": "2e71a375-501a-456c-8fd1-f7468e1721c5",
      "name": "Save Markdown File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        1328,
        304
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a Senior QA Engineer.\n\nUsing the requirement document and test plan, generate comprehensive test cases.\n\nFor each test case include:\n- Test Case ID\n- Module\n- Title\n- Preconditions\n- Test Steps\n- Test Data\n- Expected Result\n- Priority\n- Severity\n- Type (Positive/Negative)\n\nRequirement:\n{{ $(\"Extract PDF Content\").item.json.text }}\n\nTest Plan:\n{{ $(\"Generate Test Plan\").item.json.output }}\n\nReturn the test cases as a JSON array where each object represents one test case with the fields: testCaseId, module, title, preconditions, testSteps, testData, expectedResult, priority, severity, type",
        "options": {
          "systemMessage": "You are a Senior QA Engineer specialized in creating comprehensive test cases. Generate detailed test cases based on requirements and test plans. Return ONLY a valid JSON array of test case objects.",
          "maxIterations": 10
        }
      },
      "id": "42d1b886-f02a-4527-bfee-4d96989bdf05",
      "name": "Generate Test Cases",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1264,
        496
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "options": {
          "fileName": "=test-cases-{{ $now.toFormat(\"yyyy-MM-dd-HHmmss\") }}.csv",
          "headerRow": true
        }
      },
      "id": "702dd8ae-51f3-4b99-9483-d245d406510e",
      "name": "Convert to CSV File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
